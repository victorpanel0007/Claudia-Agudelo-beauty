#
# Nombre en SPA:               Nombre en este backend:
# NEXT_PUBLIC_SUPABASE_URL  →  NEXT_PUBLIC_SUPABASE_URL  (mismo nombre)
# SUPABASE_SERVICE_ROLE_KEY →  SUPABASE_SERVICE_ROLE_KEY (mismo nombre)
#
NEXT_PUBLIC_SUPABASE_URL=https://ojbjbwjrginpgfprxgkp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── OpenAI — MISMA clave que usa el SPA en Vercel ──────────
OPENAI_API_KEY=sk-proj-...
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ── Dualhook / Meta Cloud API ──────────────────────────────
# Estas son nuevas — configurar en Railway
